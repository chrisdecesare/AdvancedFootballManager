# Cartella delle foto: si servono SOLO immagini, mai codice
Options -Indexes -ExecCGI

# i file qui li serve Apache, non PHP: senza questo header mancherebbe il nosniff di lib/bootstrap.php
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>

<FilesMatch ".*">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "^[A-Za-z0-9_-]+\.(jpg|jpeg|png|webp|gif)$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Allow from all
  </IfModule>
</FilesMatch>
