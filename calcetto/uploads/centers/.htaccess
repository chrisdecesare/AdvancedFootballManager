# I loghi delle leghe e dei centri si caricano dal sito Next (calcettomanager.win) e stanno solo lì: da qui si rimanda.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^([A-Za-z0-9_.-]+)$ https://calcettomanager.win/uploads/centers/$1 [R=302,L]
</IfModule>
