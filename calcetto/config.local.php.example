define('DB_USER', 'NOMEUTENTE');        // il tuo nome utente Altervista
define('DB_PASS', '');                  // vuota, se il pannello Database non ne indica una
define('DB_NAME', 'my_NOMEUTENTE');     // di solito my_ + nome utente

// Codice da digitare in install.php per creare il primo admin
define('INSTALL_KEY', 'scegli-un-codice-lungo-e-casuale');
