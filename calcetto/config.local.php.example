// Copia questo file in config.local.php e compilalo.
// config.local.php NON va su GitHub: si carica sul server una volta sola, via FTP,
// e il deploy automatico non lo tocca mai.
if (realpath($_SERVER['SCRIPT_FILENAME'] ?? '') === __FILE__) {
    http_response_code(404);
    exit;
}

